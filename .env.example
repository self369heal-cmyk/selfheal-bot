# Токен тестового бота от @BotFather
BOT_TOKEN=123456:ABC-your-test-bot-token

# Публичный HTTPS-адрес сервера (на него Telegram будет слать апдейты)
WEBHOOK_BASE_URL=https://your-domain.example

# Адрес и порт FastAPI-сервера
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000

# Путь к файлу SQLite-базы
DATABASE_PATH=selfheal.db

# telegram_id администратора — доступ к команде /getfileid
ADMIN_TELEGRAM_ID=5925313775

# Шаблон ссылки оплаты GetCourse (кнопка «Купить»).
# Плейсхолдеры: {track_id}, {telegram_id}, {track_title} (url-encoded).
GETCOURSE_PAY_URL_TEMPLATE=https://edu.selfheal369.ru/pay-stub?track={track_id}&telegram_id={telegram_id}

# Ключ для GET /admin/db-dump (выгрузка базы для бэкапов). Пусто = эндпоинт отключён.
BACKUP_KEY=change-me-random-hex

# Прокси-адрес Bot API — если api.telegram.org недоступен с сервера
# (на РФ-хостингах). Пусто = https://api.telegram.org напрямую.
# TELEGRAM_API_BASE=https://tg-proxy.example.workers.dev

# Секрет вебхука — Telegram шлёт его заголовком X-Telegram-Bot-Api-Secret-Token.
# Заполните (openssl rand -hex 32) — отсекает поддельные апдейты.
TELEGRAM_WEBHOOK_SECRET=
